{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "tsBuildInfoFile": "./.cache/tsconfig.node.tsbuildinfo",
    "types": ["node"]
  },
  "include": ["vite.config.ts", "scripts/**/*.ts", "src/domain/game.ts", "src/domain/pack.ts", "src/data/manifest.ts"]
}
