{
  "name": "pokeplanner",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "npm@11.5.1",
  "engines": {
    "node": "22.17.1",
    "npm": "11.5.1"
  },
  "scripts": {
    "dev": "vite",
    "test": "vitest run",
    "test:watch": "vitest",
    "data:sync": "tsx scripts/data/source-cache.ts",
    "data:compile": "tsx scripts/data/compile-firered-pack.ts --write",
    "data:verify": "tsx scripts/data/compile-firered-pack.ts --check",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "prebuild": "npm run data:verify",
    "build": "vite build",
    "check": "npm run test && npm run typecheck && npm run build"
  },
  "dependencies": {
    "fflate": "0.8.3",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "22.20.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "29.1.1",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
